n_widths><column index="1" value="78"/><column index="2" value="199"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="factCharge" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="63"/><column index="2" value="71"/><column index="3" value="60"/><column index="4" value="43"/><column index="5" value="159"/><column index="6" value="159"/><column index="7" value="77"/><column index="8" value="70"/><column index="9" value="95"/><column index="10" value="60"/><column index="11" value="85"/><column index="12" value="61"/><column index="13" value="66"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">SELECT weekday,
       ROUND(AVG(chargeTimeHrs), 2) AS avgChargeTime
FROM EVCharging
GROUP BY weekday
ORDER BY avgChargeTime DESC
</sql><sql name="SQL 2">SELECT userId,
       ROUND(SUM(kwhTotal), 2) AS totalPower
FROM EVCharging
GROUP BY userId
ORDER BY totalPower DESC
LIMIT 15;</sql><sql name="SQL 3">SELECT f.typeFacility,
       COUNT(DISTINCT c.stationID) AS numStation
FROM factCharge AS c
JOIN dimFacility AS f ON c.facilityID = f.FacilityKey
GROUP BY f.typeFacility
ORDER BY numStation DESC;</sql><sql name="SQL 12">SELECT userId, MIN(chargeTimeHrs) AS minTime, MAX(chargeTimeHrs) AS maxTime
FROM EVCharging
GROUP BY userId
HAVING MIN(chargeTimeHrs) &gt; 1
ORDER BY 2 ASC, maxTime ASC;</sql><current_tab id="3"/></tab_sql></sqlb_project>
